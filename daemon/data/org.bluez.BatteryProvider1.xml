<!-- BlueZ battery provider (doc/battery-api.txt): BlueZ shows the
     percentage as org.bluez.Battery1 on the device, UPower and GNOME
     pick it up from there -->
<node>
  <interface name="org.bluez.BatteryProvider1">
    <property name="Device" type="o" access="read"/>
    <property name="Percentage" type="y" access="read"/>
    <property name="Source" type="s" access="read"/>
  </interface>
</node>
