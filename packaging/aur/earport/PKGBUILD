# Maintainer: Florent Pauliat <flo7634@gmail.com>

pkgname=earport
_uuid=earport@anoryth.github.io
pkgver=0.3.5
pkgrel=1
pkgdesc="AirPods integration for GNOME: battery, noise control modes and ear detection"
arch=('x86_64' 'aarch64')
url="https://github.com/Anoryth/earport"
license=('GPL-3.0-or-later')
depends=('glib2' 'bluez' 'gnome-shell')
makedepends=('meson' 'ninja' 'bluez-libs')
install=earport.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Run updpkgsums once the v$pkgver tag is pushed
sha256sums=('SKIP')

build() {
    arch-meson "$pkgname-$pkgver/daemon" build
    meson compile -C build
}

check() {
    meson test -C build --print-errorlogs
}

package() {
    meson install -C build --destdir "$pkgdir"

    local extdir="$pkgdir/usr/share/gnome-shell/extensions/$_uuid"
    install -d "$extdir"
    cp -r --no-preserve=ownership "$pkgname-$pkgver/extension/." "$extdir/"
    glib-compile-schemas "$extdir/schemas"

    install -Dm644 "$pkgname-$pkgver/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$pkgname-$pkgver/CREDITS" "$pkgdir/usr/share/doc/$pkgname/CREDITS"
}
