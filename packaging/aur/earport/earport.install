post_install() {
    cat <<'EOF'
==> To finish the EarPort installation, as your regular user:
      systemctl --user enable --now earport-daemon.service
      gnome-extensions enable earport@anoryth.github.io
    Then log out and back in (Wayland) so GNOME Shell loads the extension.
EOF
}

post_upgrade() {
    cat <<'EOF'
==> Restart the daemon to use the new version:
      systemctl --user restart earport-daemon.service
    GNOME Shell loads the updated extension at the next login.
EOF
}

post_remove() {
    cat <<'EOF'
==> As your regular user, stop the daemon and clean up:
      systemctl --user stop earport-daemon.service
      rm -f ~/.config/systemd/user/default.target.wants/earport-daemon.service
      rm -rf ~/.config/earport   # optional: per-device settings
EOF
}
